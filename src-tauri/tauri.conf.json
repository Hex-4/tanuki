{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tanuki",
  "version": "0.1.0",
  "identifier": "xyz.hex4.tanuki",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "width": 250,
        "height": 300
      }
    ],
    "security": {
      "csp": null
    },

    "withGlobalTauri": true

  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
  
}
